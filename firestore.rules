rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // Users may only change their display currency and email preference. Everything else is server-owned.
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayCurrency', 'emailNotifications'])
        && request.resource.data.get('displayCurrency', 'USD') is string
        && request.resource.data.get('displayCurrency', 'USD').size() == 3
        && request.resource.data.get('emailNotifications', true) is bool;
      allow create, delete: if false;

      // Saved contacts: owned and edited by the user; email/name only.
      match /contacts/{contactId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['email', 'name', 'createdAt'])
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 200
          && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100;
      }
    }

    // Money collections: read-only to the client, all writes via Cloud Functions.
    match /wallets/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }
    match /ledger/{entryId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      // The only client write: tagging your own entry with a spending category.
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category'])
        && request.resource.data.category in
          ['', 'food', 'transport', 'shopping', 'bills', 'entertainment', 'rent', 'travel', 'health', 'other'];
      allow create, delete: if false;
    }
    match /transfers/{txId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow write: if false;
    }
    match /topups/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /paymentRequests/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow write: if false;
    }
    // Invoice recipients may not have an account yet, so match on verified email.
    match /invoices/{id} {
      allow read: if signedIn() && (resource.data.issuerUid == request.auth.uid
        || (request.auth.token.email_verified == true
            && resource.data.recipientEmail == request.auth.token.email.lower()));
      allow write: if false;
    }
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }
    match /payouts/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /schedules/{id} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }
    match /splits/{id} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }
    match /stats/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /fxRates/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Owner-readable, server-written collections.
    function ownsBy(field) { return signedIn() && resource.data[field] == request.auth.uid; }
    match /balances/{id} { allow read: if ownsBy('uid'); allow write: if false; }
    match /currencyLedger/{id} { allow read: if ownsBy('uid'); allow write: if false; }
    match /conversions/{id} { allow read: if ownsBy('uid'); allow write: if false; }
    match /pots/{id} { allow read: if ownsBy('uid'); allow write: if false; }
    match /holds/{id} { allow read: if ownsBy('fromUid'); allow write: if false; }
    // Includes the webhook signing secret, which the merchant needs to verify deliveries.
    match /merchants/{uid} { allow read: if isSelf(uid); allow write: if false; }
    // Only the hash and display prefix are stored; never the key itself.
    match /apiKeys/{hash} { allow read: if ownsBy('uid'); allow write: if false; }
    match /checkouts/{id} { allow read: if ownsBy('merchantUid'); allow write: if false; }
    match /webhookDeliveries/{id} { allow read: if ownsBy('merchantUid'); allow write: if false; }
    // mailOutbox: server only (falls through to deny-all).

    // auditLogs, dailyTotals, system, and anything else: no client access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
